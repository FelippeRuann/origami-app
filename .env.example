# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------
# FIREBASE VARIABLES (Exposed to the app via EXPO_PUBLIC_)
# ------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY="sua_chave_aqui"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="seu_projeto.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="seu_projeto"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="seu_projeto.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="seu_sender_id"
EXPO_PUBLIC_FIREBASE_APP_ID="seu_app_id"

# ------------------------------------------------------------
# CLOUDINARY (If used in the backend for image processing)
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="seu_cloud_name"
CLOUDINARY_API_KEY="seu_api_key_aqui"
CLOUDINARY_API_SECRET="seu_api_secret_aqui"

# ------------------------------------------------------------
# FOLD (chave mestra da criptografia dos arquivos .fold)
# Uso exclusivo do servidor. Trocar este valor torna ilegiveis
# todos os .fold ja gerados com a chave anterior.
# ------------------------------------------------------------
FOLD_SECRET="sua_chave_mestra_aqui"

# ------------------------------------------------------------
# IDENTIDADES DO APP (embutidas no bundle via EXPO_PUBLIC_)
# ------------------------------------------------------------
EXPO_PUBLIC_ADMIN_EMAILS="um@exemplo.com,outro@exemplo.com"
EXPO_PUBLIC_SUPPORT_EMAIL="suporte@exemplo.com"
